# 数据库文件路径（默认 data/moyun.db，可省略）
DATABASE_PATH=./data/moyun.db

# 上传文件目录（默认 public/uploads，可省略）
UPLOAD_DIR=./public/uploads

# NextAuth 密钥（必填，随机长字符串即可）
# 生成示例：openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-string
# NEXTAUTH_SECRET=  # 与 AUTH_SECRET 二选一，兼容写法

# 种子脚本创建管理员时使用的密码（可选）
# 不设置时自动生成随机密码，并写入 .local/admin-credentials.txt
# ADMIN_PASSWORD=
